---
interface Props {
  /** Accessible labels; the commercial home is PT-only and passes its own. */
  toLight?: string;
  toDark?: string;
}

const { toLight = 'Mudar para o tema claro', toDark = 'Mudar para o tema escuro' } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  data-label-light={toLight}
  data-label-dark={toDark}
  aria-label={toLight}
  aria-pressed="false"
  class="text-faint transition-colors hover:text-accent-bright"
>
  {/* Sun in dark mode (click for light), moon in light mode. */}
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4 dark-icon" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
      stroke-linecap="round"></path>
  </svg>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4 light-icon" aria-hidden="true">
    <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z" stroke-linejoin="round"></path>
  </svg>
</button>

<style>
  /* Which glyph shows follows the resolved theme, so it is correct on first
     paint without waiting for JS. */
  .light-icon {
    display: none;
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) .dark-icon {
      display: none;
    }
    :root:not([data-theme="dark"]) .light-icon {
      display: block;
    }
  }
  :root[data-theme="light"] .dark-icon {
    display: none;
  }
  :root[data-theme="light"] .light-icon {
    display: block;
  }
  :root[data-theme="dark"] .dark-icon {
    display: block;
  }
  :root[data-theme="dark"] .light-icon {
    display: none;
  }
</style>
