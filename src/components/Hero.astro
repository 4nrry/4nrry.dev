---
import { resolveLocale, ui } from '../i18n/ui';
import LangToggle from './LangToggle.astro';
import ThemeToggle from './ThemeToggle.astro';
const locale = resolveLocale(Astro.currentLocale);
const t = ui[locale].hero;
// Same label as the footer link back to the commercial home.
const backHome = ui[locale].contact.hire;
---

<header data-journey="hero" class="mx-auto max-w-5xl px-6 pt-16 sm:pt-24 pb-10">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
    <p class="font-mono text-xs sm:text-sm text-faint">
      anrry@4nrry.dev:~$ <span class="text-accent">replay</span> --since "2 years ago"
    </p>
    <div class="flex items-baseline gap-4">
      <a
        href="/"
        class="-my-3 inline-flex min-h-11 items-center self-center font-mono text-xs text-accent-bright transition-colors hover:text-accent"
        >← {backHome}</a
      >
      <LangToggle />
      <ThemeToggle toLight={t.themeToLight} toDark={t.themeToDark} />
    </div>
  </div>
  <h1 class="mt-6 font-mono text-5xl sm:text-7xl font-extrabold tracking-tight">Anrry Petrin</h1>
  <p class="mt-4 max-w-xl text-lg text-muted">{t.role}</p>

  {/* gap-x-3 below sm buys each track 2.7px, which is what keeps the 13-character
      "contribuições" label on one line at 320px. The figures size themselves off
      the track width — see .counter-figure. */}
  <dl class="mt-10 grid max-w-2xl grid-cols-3 gap-x-3 gap-y-4 sm:gap-4">
    <div>
      <dd id="counter-contributions" class="counter-figure font-mono font-extrabold text-accent-bright">···</dd>
      <dt class="mt-1 font-mono text-[0.65rem] sm:text-xs text-faint">{t.counterContributions}</dt>
    </div>
    <div>
      <dd id="counter-prs" class="counter-figure font-mono font-extrabold text-accent-bright">···</dd>
      <dt class="mt-1 font-mono text-[0.65rem] sm:text-xs text-faint">{t.counterPrs}</dt>
    </div>
    <div>
      <dd id="counter-streak" class="counter-figure font-mono font-extrabold text-accent-bright">···</dd>
      <dt class="mt-1 font-mono text-[0.65rem] sm:text-xs text-faint">{t.counterStreak}</dt>
    </div>
  </dl>

  <div class="mt-10">
    {/* No min-width and no scroll box: the replay picks its own window so the
        cells stay legible at whatever width it gets. A pinned 640px drew 3px
        cells on a phone, with half the chart behind a scroll nothing hinted at.
        The full two years stay in the data table below. */}
    <canvas id="viz-calendar" class="shimmer w-full rounded-md"></canvas>
    <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-2">
      <p id="calendar-ticker" class="font-mono text-xs text-accent" aria-live="off"></p>
      <span class="flex-1"></span>
      <p id="sync-chip" class="font-mono text-[0.7rem] sm:text-[0.65rem] text-faint">{t.chipConnecting}</p>
      <button
        id="replay-hero"
        type="button"
        class="rounded border border-border px-3 py-2 font-mono text-[0.7rem] sm:text-[0.65rem] text-muted transition-colors hover:border-accent hover:text-accent-bright"
      >
        {t.replay}
      </button>
    </div>
    <p class="mt-4 max-w-2xl text-sm text-faint">{t.caption}</p>
    <details class="viz-table mt-3">
      <summary>{t.tableSummary}</summary>
      <div data-scroll-x>
        <table>
          <thead><tr><th>{t.tableMonth}</th><th>{t.tableContributions}</th></tr></thead>
          <tbody id="table-months-body"></tbody>
        </table>
      </div>
    </details>
  </div>
</header>
