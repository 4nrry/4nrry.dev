---
import { resolveLocale, ui } from '../i18n/ui';
const t = ui[resolveLocale(Astro.currentLocale)].rhythm;
---

<section id="section-rhythm" class="mx-auto max-w-5xl px-6 py-14 sm:py-16">
  <p class="eyebrow">rhythm</p>
  <h2 class="mt-2 font-mono text-2xl sm:text-3xl font-bold">{t.title}</h2>
  <p class="mt-3 max-w-2xl text-muted">{t.intro}</p>
  {/* Cells follow the column width now (see weekday-heatmap.ts), so the chart
      fits any screen instead of forcing a 640px canvas into a scroll box. */}
  <canvas id="viz-weekday" class="shimmer mt-8 w-full rounded-md"></canvas>
  {/* This chart's numbers lived only in the tooltip, which needs a pointer.
      Same fallback the calendar and the repo bars already carry. */}
  <details class="viz-table mt-3">
    <summary>{t.tableSummary}</summary>
    <div data-scroll-x>
      <table>
        <thead><tr id="table-weekday-head"><th>{t.tableDay}</th></tr></thead>
        <tbody id="table-weekday-body"></tbody>
      </table>
    </div>
  </details>
</section>
