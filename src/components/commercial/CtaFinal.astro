---
import WhatsAppButton from './WhatsAppButton.astro';
---

<section id="contato" class="mx-auto max-w-5xl scroll-mt-20 px-6 pb-20 pt-14 sm:pt-16">
  <div class="card reveal p-8 text-center sm:p-12">
    <h2 class="text-2xl font-bold sm:text-3xl">Me conta seu problema.</h2>
    <p class="mt-3 text-muted">Se eu não for a pessoa certa pra resolver, eu te digo.</p>
    <div class="mt-7 flex justify-center">
      <WhatsAppButton />
    </div>
  </div>
</section>
