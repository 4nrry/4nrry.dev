---
import WhatsAppButton from './WhatsAppButton.astro';
---

<section id="contato" class="mx-auto max-w-5xl scroll-mt-8 px-6 pb-20 pt-14 sm:pt-16">
  <div class="card p-8 text-center sm:p-12">
    <h2 class="text-2xl font-bold sm:text-3xl">Me conta seu problema.</h2>
    <p class="mt-3 text-muted">Se eu não for a pessoa certa pra resolver, eu te digo.</p>
    <div class="mt-7 flex justify-center">
      <WhatsAppButton />
    </div>
  </div>
  <div
    class="mt-10 flex flex-wrap items-center justify-between gap-3 border-t border-border pt-6 font-mono text-xs text-faint"
  >
    <p>
      Feito por mim, do design ao deploy.
      <a
        class="underline underline-offset-2 transition-colors hover:text-muted"
        href="https://github.com/4nrry/4nrry.dev"
        rel="noopener">Código aberto no GitHub.</a
      >
    </p>
    <p>
      <a class="transition-colors hover:text-muted" href="https://github.com/4nrry" rel="noopener"
        >github.com/4nrry</a
      >
      · <a class="transition-colors hover:text-muted" href="/pt/dev/">portfólio técnico</a>
    </p>
  </div>
</section>
