---
import { Image } from 'astro:assets';
import energyflux from '../../assets/lp-energyflux.jpg';
import nutrirebrincar from '../../assets/lp-nutrirebrincar.jpg';

const sites = [
  {
    name: 'EnergyFlux Engenharia',
    kind: 'Energia solar · Sorocaba',
    body: 'A página apresenta o serviço do projeto à homologação, coloca os números da empresa logo na primeira dobra e leva quem chega direto pro orçamento no WhatsApp.',
    href: 'https://energyflux.eng.br',
    label: 'energyflux.eng.br',
    image: energyflux,
  },
  {
    name: 'Nutrir & Brincar',
    kind: 'Escola de educação alimentar · Sorocaba',
    body: 'A página conta a metodologia, mostra a estrutura da escola e os depoimentos das famílias, e transforma a visita em aula experimental agendada.',
    href: 'https://www.nutrirebrincar.com.br',
    label: 'nutrirebrincar.com.br',
    image: nutrirebrincar,
  },
];

const systems = [
  {
    name: 'SmartCompost',
    kind: 'Plataforma de compostagem inteligente',
    color: 'var(--color-org-smart)',
    body: 'Entrei como primeiro e único desenvolvedor e construí a plataforma completa: site, aplicativo, painéis e a ponte com os equipamentos. Hoje o produto está em produção, com clientes acompanhando a compostagem em tempo real, e eu sigo como engenheiro responsável.',
  },
  {
    name: 'Ocean Words',
    kind: 'Plataforma de ensino de inglês',
    color: 'var(--color-org-ocean)',
    body: 'Minha namorada dá aulas de inglês e vive o problema de todo professor autônomo: material espalhado e aluno sem um lugar só. Estamos construindo juntos a plataforma dela: aulas, conteúdo e acompanhamento no mesmo lugar.',
  },
];
---

<section id="projetos" class="mx-auto max-w-5xl scroll-mt-8 px-6 py-14 sm:py-16">
  <p class="eyebrow">projetos</p>
  <h2 class="mt-2 text-2xl font-bold sm:text-3xl">Sites que eu fiz pra negócios daqui</h2>
  <p class="mt-3 max-w-2xl leading-relaxed text-muted">
    Duas empresas de Sorocaba que hoje têm uma página trabalhando por elas. Pode abrir e conferir: as
    duas estão no ar.
  </p>

  <div class="mt-8 grid gap-5 sm:grid-cols-2">
    {
      sites.map((site) => (
        <article class="card overflow-hidden">
          <a href={site.href} rel="noopener" class="block" aria-label={`Abrir o site da ${site.name}`}>
            <Image
              src={site.image}
              alt={`Página inicial do site da ${site.name}`}
              widths={[640, 1280]}
              sizes="(min-width: 640px) 460px, 100vw"
              loading="lazy"
              class="aspect-[8/5] w-full border-b border-border object-cover object-top transition-opacity hover:opacity-90"
            />
          </a>
          <div class="p-6">
            <h3 class="text-lg font-semibold">{site.name}</h3>
            <p class="mt-1 font-mono text-xs text-faint">{site.kind}</p>
            <p class="mt-3 text-sm leading-relaxed text-muted">{site.body}</p>
            <a
              href={site.href}
              rel="noopener"
              class="mt-4 inline-block font-mono text-sm text-accent-bright transition-colors hover:text-accent"
            >
              ver o site no ar: {site.label} →
            </a>
          </div>
        </article>
      ))
    }
  </div>

  <h3 class="mt-14 text-xl font-bold sm:text-2xl">Também construo sistemas</h3>
  <p class="mt-3 max-w-2xl leading-relaxed text-muted">
    Quando o problema é maior que uma página, eu vou até o fim: produto rodando em produção, com
    usuário de verdade dentro.
  </p>
  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    {
      systems.map((s) => (
        <article class="card border-t-2 p-6" style={`border-top-color: ${s.color}`}>
          <h4 class="font-semibold">{s.name}</h4>
          <p class="mt-1 font-mono text-xs text-faint">{s.kind}</p>
          <p class="mt-3 text-sm leading-relaxed text-muted">{s.body}</p>
        </article>
      ))
    }
  </div>
  <p class="mt-6 max-w-3xl text-sm leading-relaxed text-faint">
    E mais dois que eu toco junto com o <a
      class="text-muted underline underline-offset-2 transition-colors hover:text-accent-bright"
      href="https://andrefranceschini.com.br"
      rel="noopener">André Franceschini</a
    >, consultor de sistemas aqui de Sorocaba: <span class="text-muted"
      ><span style="color: var(--color-org-lotvs)" aria-hidden="true">●</span> LOTVS</span
    >, app de controle financeiro, e <span class="text-muted"
      ><span class="text-accent" aria-hidden="true">●</span> Temakuri</span
    >, jogo de cartas online em tempo real, de código aberto. De landing page a jogo multiplayer: eu
    transito no espectro inteiro.
  </p>
</section>
