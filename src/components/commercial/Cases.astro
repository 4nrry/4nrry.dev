---
import SiteCard from './SiteCard.astro';
import energyflux from '../../assets/lp-energyflux.jpg';
import nutrirebrincar from '../../assets/lp-nutrirebrincar.jpg';
import oceanwords from '../../assets/lp-oceanwords.jpg';
import lotvs from '../../assets/lp-lotvs.jpg';
import smartcompost from '../../assets/lp-smartcompost.jpg';

const sites = [
  {
    name: 'EnergyFlux Engenharia',
    kind: 'Energia solar · Sorocaba',
    body: 'A página apresenta o serviço do projeto à homologação, coloca os números da empresa logo na primeira dobra e leva quem chega direto pro orçamento no WhatsApp.',
    href: 'https://energyflux.eng.br',
    label: 'energyflux.eng.br',
    image: energyflux,
  },
  {
    name: 'Nutrir & Brincar',
    kind: 'Escola de educação alimentar · Sorocaba',
    body: 'A página conta a metodologia, mostra a estrutura da escola e os depoimentos das famílias, e transforma a visita em aula experimental agendada.',
    href: 'https://www.nutrirebrincar.com.br',
    label: 'nutrirebrincar.com.br',
    image: nutrirebrincar,
  },
];

const SMART_COMPOST = {
  name: 'SmartCompost',
  kind: 'Monitoramento de resíduos · meu trabalho principal',
  body: 'Entrei como primeiro e único desenvolvedor e construí o produto completo: este site, o aplicativo, os painéis e a ponte com os equipamentos em campo. Hoje está em produção, com clientes acompanhando o monitoramento em tempo real, e eu sigo lá como engenheiro responsável.',
  href: 'https://smartcompost.com.br',
  label: 'smartcompost.com.br',
  image: smartcompost,
};

const products = [
  {
    name: 'Ocean Words',
    kind: 'Escola de inglês · Sorocaba',
    body: 'A escola da minha namorada, que dá as aulas. Construí a plataforma inteira: site, agendamento de aula experimental, área do aluno e os jogos de praticar.',
    href: 'https://oceanwords.academy',
    label: 'oceanwords.academy',
    image: oceanwords,
  },
  {
    name: 'LOTVS Finance',
    kind: 'Controle financeiro pessoal',
    partner: { label: 'André Franceschini', href: 'https://andrefranceschini.com.br' },
    body: 'App que mostra pra onde vai o seu dinheiro, mês a mês. Cuido do produto de ponta a ponta: painel, backend e a página que abre aí.',
    href: 'https://lotvs.finance',
    label: 'lotvs.finance',
    image: lotvs,
  },
];
---

<section id="projetos" class="mx-auto max-w-5xl scroll-mt-20 px-6 py-14 sm:py-16">
  <p class="eyebrow">projetos</p>
  <h2 class="mt-2 text-2xl font-bold sm:text-3xl">Sites que eu fiz pra negócios daqui</h2>
  <p class="mt-3 max-w-2xl leading-relaxed text-muted">
    Duas empresas de Sorocaba que hoje têm uma página trabalhando por elas. Pode abrir e conferir: as
    duas estão no ar.
  </p>

  <div class="mt-8 grid gap-5 sm:grid-cols-2" data-reveal-group>
    {sites.map((item) => <SiteCard item={item} />)}
  </div>

  {/* A second H2: it is a sibling topic of "Sites que eu fiz", not a child of
      it, and the SiteCard names below it are the H3s. */}
  <h2 class="mt-16 text-xl font-bold sm:text-2xl">Produtos que eu construí do zero</h2>
  <p class="mt-3 max-w-2xl leading-relaxed text-muted">
    Quando o problema é maior que uma página, eu vou até o fim. Os três estão no ar e você pode
    entrar e conferir.
  </p>
  <div class="mt-8 grid gap-5 sm:grid-cols-2" data-reveal-group>
    {products.map((item) => <SiteCard item={item} />)}
  </div>

  <div class="mt-5">
    <SiteCard item={SMART_COMPOST} wide />
  </div>
</section>
