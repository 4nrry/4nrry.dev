---
import { faqs } from './faqs';
---

<section id="faq" class="mx-auto max-w-5xl scroll-mt-20 px-6 py-14 sm:py-16">
  <p class="eyebrow">perguntas</p>
  <h2 class="mt-2 text-2xl font-bold sm:text-3xl">Perguntas frequentes</h2>
  <div class="mt-8 grid gap-x-8 gap-y-7 sm:grid-cols-2" data-reveal-group>
    {
      faqs.map((f) => (
        <div class="reveal">
          <h3 class="font-semibold">{f.q}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-muted">{f.a}</p>
        </div>
      ))
    }
  </div>
</section>
