---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  item: {
    name: string;
    kind: string;
    body: string;
    href: string;
    label: string;
    image: ImageMetadata;
  };
}

const { item } = Astro.props;
---

<article class="card overflow-hidden">
  <a href={item.href} rel="noopener" class="block" aria-label={`Abrir o site da ${item.name}`}>
    <Image
      src={item.image}
      alt={`Página inicial do site da ${item.name}`}
      widths={[640, 1280]}
      sizes="(min-width: 640px) 460px, 100vw"
      loading="lazy"
      class="aspect-[8/5] w-full border-b border-border object-cover object-top transition-opacity hover:opacity-90"
    />
  </a>
  <div class="p-6">
    <h3 class="text-lg font-semibold">{item.name}</h3>
    <p class="mt-1 font-mono text-xs text-faint">{item.kind}</p>
    <p class="mt-3 text-sm leading-relaxed text-muted">{item.body}</p>
    <a
      href={item.href}
      rel="noopener"
      class="mt-4 inline-block font-mono text-sm text-accent-bright transition-colors hover:text-accent"
    >
      ver o site no ar: {item.label} →
    </a>
  </div>
</article>
