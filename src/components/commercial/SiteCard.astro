---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  item: {
    name: string;
    kind: string;
    body: string;
    href: string;
    label: string;
    image: ImageMetadata;
    partner?: { label: string; href: string };
  };
  /** Image beside the text instead of above it, for a full-width card. */
  wide?: boolean;
}

const { item, wide = false } = Astro.props;
---

<article class:list={['card overflow-hidden', wide && 'sm:flex sm:items-stretch']}>
  <a
    href={item.href}
    rel="noopener"
    class:list={['block', wide && 'sm:w-1/2 sm:shrink-0']}
    aria-label={`Abrir o site da ${item.name}`}
  >
    <Image
      src={item.image}
      alt={`Página inicial do site da ${item.name}`}
      widths={[640, 1280]}
      sizes="(min-width: 640px) 512px, 100vw"
      loading="lazy"
      class:list={[
        'aspect-[8/5] w-full object-cover object-top transition-opacity hover:opacity-90',
        wide ? 'border-b border-border sm:h-full sm:border-b-0 sm:border-r' : 'border-b border-border',
      ]}
    />
  </a>
  <div class:list={['p-6', wide && 'sm:flex-1']}>
    <h3 class="text-lg font-semibold">{item.name}</h3>
    <p class="mt-1 font-mono text-xs text-faint">
      {item.kind}
      {
        item.partner && (
          <>
            {' · com '}
            <a
              class="underline underline-offset-2 transition-colors hover:text-accent-bright"
              href={item.partner.href}
              rel="noopener"
            >
              {item.partner.label}
            </a>
          </>
        )
      }
    </p>
    <p class="mt-3 text-sm leading-relaxed text-muted">{item.body}</p>
    <a
      href={item.href}
      rel="noopener"
      class="mt-4 inline-block font-mono text-sm text-accent-bright transition-colors hover:text-accent"
    >
      ver o site no ar: {item.label} →
    </a>
  </div>
</article>
