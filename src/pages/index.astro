---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/commercial/Hero.astro';
import Services from '../components/commercial/Services.astro';
import Cases from '../components/commercial/Cases.astro';
import Process from '../components/commercial/Process.astro';
import UnderTheHood from '../components/commercial/UnderTheHood.astro';
import About from '../components/commercial/About.astro';
import Faq from '../components/commercial/Faq.astro';
import CtaFinal from '../components/commercial/CtaFinal.astro';
---

<Layout
  lang="pt-BR"
  title="Anrry Petrin · Sites e sistemas sob medida"
  description="Sites, sistemas e automações sob medida pra pequenos e médios negócios. Proposta com preço fechado, entrega documentada, código seu. Chama no WhatsApp."
  ogImage="/og-comercial.png"
  ogLocale="pt_BR"
  withHreflang={false}
  pending={false}
>
  <main>
    <Hero />
    <Services />
    <Cases />
    <Process />
    <UnderTheHood />
    <About />
    <Faq />
    <CtaFinal />
  </main>
</Layout>

<script>
  import '../scripts/commercial';
</script>
