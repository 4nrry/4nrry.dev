---
import '@fontsource-variable/inter';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/700.css';
import '@fontsource/jetbrains-mono/800.css';
import '../styles/global.css';
import { resolveLocale, ui } from '../i18n/ui';

interface Props {
  lang?: string;
  title?: string;
  description?: string;
  ogImage?: string;
  ogLocale?: string;
  withHreflang?: boolean;
  pending?: boolean;
}

const locale = resolveLocale(Astro.currentLocale);
const t = ui[locale].layout;
const {
  lang = locale,
  title = t.title,
  description = t.description,
  ogImage: ogImagePath = t.ogImage,
  ogLocale = t.ogLocale,
  withHreflang = true,
  pending = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const enUrl = new URL('/dev/', Astro.site);
const ptUrl = new URL('/pt/dev/', Astro.site);
const ogImage = new URL(ogImagePath, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {
      withHreflang && (
        <>
          <link rel="alternate" hreflang="en" href={enUrl} />
          <link rel="alternate" hreflang="pt-BR" href={ptUrl} />
          <link rel="alternate" hreflang="x-default" href={enUrl} />
        </>
      )
    }
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="bg-bg text-text antialiased" data-pending={pending ? 'true' : undefined}>
    <slot />
  </body>
</html>
